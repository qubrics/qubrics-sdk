{
  "name": "qubrics/sdk-monorepo",
  "description": "Development workspace for Qubrics PHP SDK packages.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "qubrics/core": "3.0.0",
    "qubrics/mailbox": "3.0.0",
    "qubrics/management": "3.0.0",
    "qubrics/sdk": "3.0.0",
    "qubrics/sending": "3.0.0",
    "squizlabs/php_codesniffer": "^3.13.6"
  },
  "autoload-dev": {
    "psr-4": {
      "Qubrics\\Tests\\": "packages/php/tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/php/core",
      "options": {
        "symlink": true,
        "versions": {
          "qubrics/core": "3.0.0"
        }
      }
    },
    {
      "type": "path",
      "url": "packages/php/sending",
      "options": {
        "symlink": true,
        "versions": {
          "qubrics/sending": "3.0.0"
        }
      }
    },
    {
      "type": "path",
      "url": "packages/php/mailbox",
      "options": {
        "symlink": true,
        "versions": {
          "qubrics/mailbox": "3.0.0"
        }
      }
    },
    {
      "type": "path",
      "url": "packages/php/management",
      "options": {
        "symlink": true,
        "versions": {
          "qubrics/management": "3.0.0"
        }
      }
    },
    {
      "type": "path",
      "url": "packages/php/sdk",
      "options": {
        "symlink": true,
        "versions": {
          "qubrics/sdk": "3.0.0"
        }
      }
    }
  ],
  "config": {
    "sort-packages": true
  }
}
