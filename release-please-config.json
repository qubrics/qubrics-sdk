{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "sequential-calls": true,
  "separate-pull-requests": true,
  "always-update": true,
  "always-link-local": true,
  "plugins": [
    {
      "type": "node-workspace"
    }
  ],
  "group-pull-request-title-pattern": "chore: release ${branch}",
  "packages": {
    "packages/ts/core": {
      "component": "ts-core",
      "package-name": "@qubrics/core",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ts/sending": {
      "component": "ts-sending",
      "package-name": "@qubrics/sending",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ts/mailbox": {
      "component": "ts-mailbox",
      "package-name": "@qubrics/mailbox",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ts/management": {
      "component": "ts-management",
      "package-name": "@qubrics/management",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ts/sdk": {
      "component": "ts-sdk",
      "package-name": "@qubrics/sdk",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ts/cli": {
      "component": "ts-cli",
      "package-name": "@qubrics/cli",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ts/ai-sdk": {
      "component": "ts-ai-sdk",
      "package-name": "@qubrics/ai-sdk",
      "initial-version": "0.1.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/python/langchain": {
      "component": "python-langchain",
      "package-name": "langchain-sendmux",
      "release-type": "python",
      "initial-version": "0.1.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/python/core": {
      "component": "python-core",
      "package-name": "sendmux-core",
      "release-type": "python",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/python/sending": {
      "component": "python-sending",
      "package-name": "sendmux-sending",
      "release-type": "python",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/python/mailbox": {
      "component": "python-mailbox",
      "package-name": "sendmux-mailbox",
      "release-type": "python",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/python/management": {
      "component": "python-management",
      "package-name": "sendmux-management",
      "release-type": "python",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/python/sdk": {
      "component": "python-sdk",
      "package-name": "sendmux-sdk",
      "release-type": "python",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/python/mcp": {
      "component": "python-mcp",
      "package-name": "sendmux-mcp",
      "release-type": "python",
      "initial-version": "1.0.0",
      "extra-files": [
        {
          "type": "json",
          "path": "server.json",
          "jsonpath": "$.packages[?(@.registryType==\"pypi\" && @.identifier==\"sendmux-mcp\")].version"
        }
      ],
      "exclude-paths": [
        "evidence"
      ]
    },
    "go": {
      "component": "go",
      "package-name": "sendmux.ai/go/v3",
      "release-type": "go",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "/",
      "initial-version": "1.0.0"
    },
    "rust": {
      "component": "rust",
      "package-name": "sendmux",
      "release-type": "rust",
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "toml",
          "path": "ci/floor-consumer/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='sendmux')].version"
        }
      ],
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ruby/core": {
      "component": "ruby-core",
      "package-name": "qubrics-core",
      "release-as": "2.0.0",
      "release-type": "ruby",
      "version-file": "lib/qubrics/core/version.rb",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ruby/sending": {
      "component": "ruby-sending",
      "package-name": "qubrics-sending",
      "release-as": "2.0.0",
      "release-type": "ruby",
      "version-file": "lib/qubrics/sending/version.rb",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ruby/mailbox": {
      "component": "ruby-mailbox",
      "package-name": "qubrics-mailbox",
      "release-as": "3.0.0",
      "release-type": "ruby",
      "version-file": "lib/qubrics/mailbox/version.rb",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ruby/management": {
      "component": "ruby-management",
      "package-name": "qubrics-management",
      "release-as": "3.0.0",
      "release-type": "ruby",
      "version-file": "lib/qubrics/management/version.rb",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ruby/sdk": {
      "component": "ruby-sdk",
      "package-name": "qubrics-sdk",
      "release-as": "3.0.0",
      "release-type": "ruby",
      "version-file": "lib/qubrics/sdk/version.rb",
      "initial-version": "1.0.0",
      "exclude-paths": [
        "evidence"
      ]
    },
    "packages/ts/mcp": {
      "component": "ts-mcp",
      "package-name": "sendmux-mcp",
      "initial-version": "1.0.0",
      "extra-files": [
        {
          "type": "json",
          "path": "/packages/python/mcp/server.json",
          "jsonpath": "$.packages[?(@.registryType==\"npm\" && @.identifier==\"sendmux-mcp\")].version"
        }
      ],
      "exclude-paths": [
        "evidence"
      ]
    }
  }
}
