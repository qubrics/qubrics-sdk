{
  "name": "@qubrics/cli",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "qubrics": "./bin/run.js",
    "sendmux": "./bin/sendmux.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && oclif manifest",
    "pack:tarballs": "node ../../../scripts/pack-cli-tarballs.mjs",
    "pretarball": "node bin/prepare-tarball.mjs"
  },
  "dependencies": {
    "@oclif/core": "4.11.4",
    "@qubrics/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "oclif": "4.23.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qubrics/qubrics-sdk.git",
    "directory": "packages/ts/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "oclif": {
    "bin": "qubrics",
    "binAliases": [
      "sendmux"
    ],
    "dirname": "sendmux",
    "commands": "./dist/commands",
    "topicSeparator": ":",
    "topics": {
      "agent": {
        "description": "Register and link agent inboxes"
      },
      "mailbox": {
        "description": "Mailbox API commands"
      },
      "management": {
        "description": "Management API commands"
      },
      "profiles": {
        "description": "Manage local Qubrics CLI profiles"
      },
      "sending": {
        "description": "Sending API commands"
      }
    }
  }
}
